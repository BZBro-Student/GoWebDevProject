package components

templ Community() {
    <div class="flex gap-4 w-full h-[calc(100vh-60px)] p-4 box-border">
        <div class="flex-1 flex flex-col gap-4 h-full overflow-hidden">
        <textarea
            class="w-full flex-1 py-6 px-4 bg-brand-dark text-white border border-[#444444] rounded-md outline-none box-border leading-relaxed text-[15px] overflow-y-auto resize-none"
            readonly
        >Pane 1 Test</textarea>
        <textarea
            class="w-full flex-1 py-6 px-4 bg-brand-dark text-white border border-[#444444] rounded-md outline-none box-border leading-relaxed text-[15px] overflow-y-auto resize-none"
            readonly
        >Pane 2 Test</textarea>
        </div>
        @SideBar([]templ.Component{Chat()})
    </div>
}
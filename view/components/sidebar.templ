package components

templ SideBar(items []templ.Component) {
	<div class="flex h-full relative">
		<!-- Hidden Checkbox State Handler -->
		<input type="checkbox" id="sidebar-toggle" class="peer hidden" />

		<!-- Sidebar Drawer -->
		<aside class="w-64 h-full bg-[#2d2d2d] border-r border-[#444444] transition-all duration-300 ease-in-out overflow-hidden peer-checked:w-0 peer-checked:border-r-0">
			<!-- Inner container with fixed width prevents text wrapping during collapse -->
			<div class="w-64 p-4 h-full overflow-y-auto box-border">
				for _, item := range items {
					@item
				}
			</div>
		</aside>

		<!-- Toggle Button (Bound to Hidden Checkbox via label) -->
		<label 
			for="sidebar-toggle" 
			class="mt-3 z-10 flex items-center justify-center w-8 h-8 bg-[#2d2d2d] text-white border border-[#444444] border-l-0 rounded-r-md cursor-pointer hover:bg-[#3d3d3d] select-none transition-transform duration-300 peer-checked:rotate-180"
			title="Toggle Sidebar"
		>
			&#10094;
		</label>
	</div>
}
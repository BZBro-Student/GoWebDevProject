package components

templ Dictionary() {
    <div class="flex gap-4 w-full h-[calc(100vh-60px)] box-border p-4">
        <div class="flex flex-col gap-4 flex-1 h-full min-w-0">
            <!-- Search Form -->
            <form 
                hx-get="/api/dictionary/search" 
                hx-target="#dictionary-results" 
                hx-swap="innerHTML"
                class="flex flex-col items-center gap-4 w-full"
            >
                <div class="w-full max-w-md pt-6">
                    <input
                        type="text"
                        id="search-input"
                        name="q"
                        placeholder="Search foreign words or definitions..."
                        hx-get="/api/dictionary/search"
                        hx-trigger="keyup changed delay:300ms, search"
                        hx-target="#dictionary-results"
                        hx-swap="innerHTML"
                        class="block w-full px-4 py-2 bg-brand-surface text-brand-light placeholder:text-brand-light/60 border-2 border-brand-accent rounded-md focus:ring-2 focus:ring-brand-accent outline-none text-sm transition-colors text-center"
                    />
                </div>
                <button
                    type="submit"
                    class="px-6 py-1.5 text-brand-light hover:bg-brand-accent hover:text-white rounded-md text-sm font-medium border border-brand-surface transition-colors cursor-pointer"
                >
                    Search
                </button>
            </form>

            <!-- Dynamic Results Container -->
            <div
                id="dictionary-results"
                class="w-full flex-1 p-4 bg-brand-dark text-white border border-[#444444] rounded-md box-border flex flex-col justify-between overflow-hidden"
                hx-get="/api/dictionary/search"
                hx-trigger="load, refreshDictionary from:body"
            >
                <!-- Paginated entries load here -->
            </div>
        </div>
        @SideBar([]templ.Component{TranslationAdder(), Chat()})
    </div>
}
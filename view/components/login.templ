package components

templ Login() {
    <div class="min-h-screen flex items-center justify-center bg-brand-dark p-4">
        <div class="w-80 h-80 bg-brand-surface border border-brand-accent/40 rounded-2xl flex flex-col items-center justify-center text-center p-6 gap-6 shadow-[0_20px_25px_-5px_rgba(0,0,0,0.5)]">
            <h1 class="text-brand-light text-xl font-semibold m-0">Login via GitHub!</h1>
            <a href="/auth/github" class="btn">Login</a>
        </div>
    </div>
}
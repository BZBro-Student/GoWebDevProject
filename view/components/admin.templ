package components

import "fmt"

// Document represents your article/document data model
type Document struct {
	ID      string
	Title   string
	Content string
}

templ Admin() {
	<div class="flex gap-4 w-full h-full text-brand-light">
		<div class="flex-1 flex flex-col gap-4 overflow-auto">
			<div class="flex items-start justify-between gap-6">
				<!-- Upload Form -->
				<form
					hx-post="/upload"
					hx-encoding="multipart/form-data"
					hx-target="#terminal-out"
					hx-swap="innerHTML"
					class="flex flex-col items-end gap-2"
				>
					<input
						type="file"
						name="doc_file"
						required
						class="bg-brand-dark border border-brand-accent text-brand-light rounded-md px-3 py-1.5 text-xs file:mr-2 file:py-1 file:px-2 file:border-0 file:rounded-md file:bg-brand-surface file:text-brand-light file:hover:bg-brand-accent cursor-pointer outline-none focus:border-blue-500 min-w-[200px]"
					/>
					<button
						type="submit"
						class="bg-brand-surface hover:bg-brand-accent border border-brand-accent text-brand-light px-4 py-1 rounded-md text-xs transition-colors cursor-pointer"
					>
						Add
					</button>
				</form>
				<!-- Search Form -->
				<form
					hx-get="/search"
					hx-target="#article-result-container"
					hx-swap="outerHTML"
					class="flex items-center gap-2"
				>
					<input
						type="text"
						name="q"
						placeholder="Search"
						class="bg-brand-dark border border-brand-accent text-brand-light rounded-md px-3 py-1.5 text-sm outline-none focus:border-blue-500 w-48 placeholder-brand-accent"
					/>
					<button
						type="submit"
						class="bg-brand-surface hover:bg-brand-accent border border-brand-accent text-brand-light px-4 py-1.5 rounded-md text-sm transition-colors cursor-pointer"
					>
						Submit
					</button>
				</form>
			</div>
			<!-- Article Result Container (Initial Empty State) -->
			@ArticleResult(nil)
			<!-- Terminal Output -->
			<div
				id="terminal-out"
				class="bg-brand-dark border border-brand-accent rounded-md p-4 flex-1 min-h-[160px] flex items-center justify-center font-mono text-sm overflow-auto"
			>
				<span class="text-3xl text-brand-accent font-light">Terminal Out</span>
			</div>
		</div>
		<!-- Right SideBar Column -->
		@SideBar([]templ.Component{Chat()})
	</div>
}

templ ArticleResult(doc *Document) {
	<div id="article-result-container" class="h-64 bg-brand-dark border-2 border-blue-500 rounded-md p-3 flex flex-col relative overflow-y-auto">
		<div class="flex justify-between items-center mb-3">
			<div class="bg-brand-surface border border-brand-accent px-3 py-1 rounded-md text-xs text-brand-light w-3/4 truncate">
				if doc != nil && doc.Title != "" {
					{ doc.Title }
				} else {
					Article Result
				}
			</div>
			if doc != nil {
				<button
					type="button"
					hx-delete={ fmt.Sprintf("/documents/%s", doc.ID) }
					hx-target="#article-result-container"
					hx-swap="outerHTML"
					hx-confirm="Are you sure you want to delete this document?"
					class="bg-red-950/60 hover:bg-red-900 border border-red-700 text-red-200 px-3 py-1 rounded-md text-xs transition-colors cursor-pointer"
				>
					Delete
				</button>
			} else {
				<button
					type="button"
					disabled
					class="bg-red-950/30 border border-red-900/40 text-red-400/40 px-3 py-1 rounded-md text-xs cursor-not-allowed"
				>
					Delete
				</button>
			}
		</div>
		<!-- Render unescaped HTML content -->
		<div id="article-result-content" class="flex-1 text-sm text-brand-light prose prose-invert max-w-none">
			if doc != nil {
				@templ.Raw(doc.Content)
			} else {
				<span class="text-brand-accent/60 italic">No document selected or found.</span>
			}
		</div>
	</div>
}

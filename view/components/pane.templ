package components

import "fmt"

templ DocumentPanesResponse(docID string, translatedContent string, englishContent string) {
    <!-- Left Desk Pane: Conlang Translated Document -->
    <div 
        id="pane-source" 
        class="flex-1 h-full min-w-[200px] min-h-0 bg-brand-dark border border-[#444444] rounded-md p-2 overflow-hidden flex flex-col" 
        hx-swap-oob="true"
        if docID != "" {
            hx-get={ fmt.Sprintf("/documents/%s/load", docID) }
            hx-trigger="reloadDocument from:body"
            hx-swap="none"
        }
    >
        if translatedContent != "" {
            <iframe
                src={ SafeDataURI(translatedContent) }
                class="w-full h-full border-0 bg-white rounded block"
            ></iframe>
        } else {
            <span class="text-brand-light/40 italic p-4 text-[15px]">Translated text will render here.</span>
        }
    </div>

    <!-- Right Desk Pane: Original English Document -->
    <div id="pane-translated" class="flex-1 h-full min-w-[200px] min-h-0 bg-brand-dark border border-[#444444] rounded-md p-2 overflow-hidden flex flex-col" hx-swap-oob="true">
        if englishContent != "" {
            <iframe
                src={ SafeDataURI(englishContent) }
                class="w-full h-full border-0 bg-white rounded block"
            ></iframe>
        } else {
            <span class="text-brand-light/40 italic p-4 text-[15px]">Select a document from search to load English text.</span>
        }
    </div>
}
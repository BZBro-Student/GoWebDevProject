package components

templ TranslationAdder() {
    <form id="translation-adder-form" class="flex flex-col gap-2 w-full">
        <!-- Foreign / Conlang Word Input -->
        <input
            type="text"
            id="foreign-word-input"
            name="foreign_word"
            placeholder="Foreign Word"
            required
            class="block w-full px-3 py-2 bg-brand-surface text-brand-light placeholder:text-brand-light/60 border border-brand-surface rounded-md focus:ring-2 focus:ring-brand-accent outline-none text-sm transition-colors"
        />

        <!-- User Definition Input -->
        <input
            type="text"
            id="user-definition-input"
            name="user_definition"
            placeholder="User Definition"
            class="block w-full px-3 py-2 bg-brand-surface text-brand-light placeholder:text-brand-light/60 border border-brand-surface rounded-md focus:ring-2 focus:ring-brand-accent outline-none text-sm transition-colors"
        />

        <!-- Action Buttons -->
        <div class="grid grid-cols-2 gap-2">
            <button
                type="button"
                hx-post="/api/dictionary/add"
                hx-include="#translation-adder-form"
                hx-target="#translation-log"
                hx-swap="afterbegin"
                class="w-full text-brand-light hover:bg-brand-accent hover:text-white px-3 py-2 rounded-md text-sm font-medium border border-brand-surface transition-colors cursor-pointer text-center"
            >
                Add
            </button>
            <button
                type="button"
                hx-post="/api/dictionary/remove"
                hx-include="#translation-adder-form"
                hx-target="#translation-log"
                hx-swap="afterbegin"
                class="w-full text-brand-light hover:bg-brand-accent hover:text-white px-3 py-2 rounded-md text-sm font-medium border border-brand-surface transition-colors cursor-pointer text-center"
            >
                Remove
            </button>
        </div>

        <!-- Scrollable Action Log -->
        <div
            id="translation-log"
            class="min-h-32 max-h-48 w-full p-3 bg-brand-surface/10 border border-brand-surface rounded-md overflow-y-auto space-y-1 text-xs text-brand-light/80"
        >
        </div>
    </form>
}
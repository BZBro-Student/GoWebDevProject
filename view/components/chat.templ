package components

templ Chat() {
	<div class="flex flex-col gap-2 w-full max-w-sm">
		<span class="text-sm font-medium text-brand-light">Chat</span>
		<div class="flex flex-col h-96 w-full border border-brand-surface rounded-md bg-brand-surface/10 overflow-hidden">
			<!-- Messages Area (flex-1 fills available space & pushes input to bottom) -->
			<div class="flex-1 p-3 overflow-y-auto">
				<!-- Messages go here -->
			</div>
			<div class="p-2 border-t border-brand-surface mt-auto">
				<div class="flex items-center gap-2 px-3 py-1 bg-brand-surface border border-brand-surface rounded-full focus-within:ring-2 focus-within:ring-brand-accent">
					<input
						type="text"
						placeholder="Message"
						class="w-full bg-transparent text-brand-light placeholder:text-brand-light/60 outline-none text-sm"
					/>
					<button
						type="button"
						class="px-3 py-1 text-brand-light hover:bg-brand-accent hover:text-white rounded-full text-xs font-medium border border-brand-surface transition-colors cursor-pointer shrink-0"
					>
						send
					</button>
				</div>
			</div>
		</div>
	</div>
}

package components

import "fmt"

type ChatMessage struct {
    ID        string
    UserID    string
    Username  string
    Message   string
    CreatedAt string
}

templ Chat() {
    <div class="flex flex-col gap-2 w-full max-w-sm">
        <span class="text-sm font-medium text-brand-light">Live Chat</span>
        <div class="flex flex-col h-96 w-full border border-brand-surface rounded-md bg-brand-surface/10 overflow-hidden">
            <!-- Polling Container (Fetches every 1 second) -->
            <div 
                id="chat-messages" 
                hx-get="/api/chat/messages" 
                hx-trigger="load, every 1s" 
                hx-swap="innerHTML scroll:bottom"
                class="flex-1 p-3 overflow-y-auto space-y-2 flex flex-col"
            >
                <!-- Messages render here -->
            </div>

            <!-- Message Input Form -->
            <form 
                hx-post="/api/chat/messages"
                hx-target="#chat-messages"
                hx-swap="innerHTML scroll:bottom"
                hx-on::after-request="if(event.detail.successful) this.reset();"
                class="p-2 border-t border-brand-surface mt-auto flex flex-col gap-1"
            >
                <div class="flex items-center gap-2 px-3 py-1 bg-brand-surface border border-brand-surface rounded-full focus-within:ring-2 focus-within:ring-brand-accent">
                    <input
                        type="text"
                        name="message"
                        maxlength="100"
                        required
                        autocomplete="off"
                        placeholder="Message (max 100 chars)..."
                        class="w-full bg-transparent text-brand-light placeholder:text-brand-light/60 outline-none text-sm"
                    />
                    <button
                        type="submit"
                        class="px-3 py-1 text-brand-light hover:bg-brand-accent hover:text-white rounded-full text-xs font-medium border border-brand-surface transition-colors cursor-pointer shrink-0"
                    >
                        send
                    </button>
                </div>
            </form>
        </div>
    </div>
}

templ ChatMessages(messages []ChatMessage, currentUserID string, isAdmin bool) {
    if len(messages) == 0 {
        <div class="text-xs text-brand-light/40 italic text-center py-4 my-auto">
            No active chat messages. Say hello!
        </div>
    } else {
        for _, msg := range messages {
            <div class="flex items-start justify-between gap-1 group text-xs">
                <div class="break-words max-w-[85%]">
                    <span class="font-semibold text-blue-400 mr-1.5">{ msg.Username }:</span>
                    <span class="text-brand-light/90">{ msg.Message }</span>
                </div>
                <div class="flex items-center gap-1 shrink-0">
                    <span class="text-[10px] text-brand-light/40">{ msg.CreatedAt }</span>
                    if isAdmin || msg.UserID == currentUserID {
                        <button 
                            type="button"
                            hx-delete={ fmt.Sprintf("/api/chat/messages/%s", msg.ID) }
                            hx-target="#chat-messages"
                            hx-swap="innerHTML"
                            class="text-red-400 hover:text-red-300 opacity-0 group-hover:opacity-100 transition-opacity ml-1 font-bold text-xs"
                            title="Delete Message"
                        >
                            &times;
                        </button>
                    }
                </div>
            </div>
        }
    }
}
package components

templ Desk() {
    <div class="flex gap-4 w-full h-[calc(100vh-60px)] box-border p-4">
        <textarea 
            class="flex-1 h-full min-w-[200px] py-6 px-4 bg-brand-dark text-white border border-[#444444] rounded-md resize-x outline-none box-border leading-relaxed text-[15px] overflow-y-auto" 
            readonly>Pane 1 Test</textarea>
        <textarea 
            class="flex-1 h-full min-w-[200px] py-6 px-4 bg-brand-dark text-white border border-[#444444] rounded-md resize-x outline-none box-border leading-relaxed text-[15px] overflow-y-auto" 
            readonly>Pane 2 Test</textarea>
        @SideBar([]templ.Component{DocumentSearch(), TranslationAdder(), Chat()})
    </div>
}
package components

import "fmt"

type Document struct {
    ID      string
    Title   string
    Content string
}

templ Desk(doc *Document, translatedContent string) {
    <div class="flex gap-4 w-full h-[calc(100vh-60px)] box-border p-4">
        
        <!-- Panes Wrapper -->
        <div id="document-panes-wrapper" 
             class="flex-1 flex gap-4 h-full"
             if doc != nil && doc.ID != "" {
                 hx-get={ fmt.Sprintf("/api/document/panes/%s", doc.ID) }
                 hx-trigger="reloadDocument from:body"
                 hx-swap="outerHTML"
             }>
            
            <!-- Source English Pane -->
            <div id="pane-source" class="flex-1 h-full min-w-[200px] bg-brand-dark border border-[#444444] rounded-md p-2 overflow-hidden flex flex-col">
                if doc != nil && doc.Content != "" {
                    <iframe
                        srcdoc={ doc.Content }
                        class="w-full h-full border-0 bg-white rounded"
                        sandbox="allow-scripts"
                    ></iframe>
                } else {
                    <span class="text-brand-light/40 italic p-4 text-[15px]">Select a document from search to load English text.</span>
                }
            </div>

            <!-- Conlang Translated Pane -->
            <div id="pane-translated" class="flex-1 h-full min-w-[200px] bg-brand-dark border border-[#444444] rounded-md p-2 overflow-hidden flex flex-col">
                if translatedContent != "" {
                    <iframe
                        srcdoc={ translatedContent }
                        class="w-full h-full border-0 bg-white rounded"
                        sandbox="allow-scripts"
                    ></iframe>
                } else {
                    <span class="text-brand-light/40 italic p-4 text-[15px]">Translated text will automatically render here.</span>
                }
            </div>
            
        </div>

        @SideBar([]templ.Component{DocumentSearch(), TranslationAdder(), Chat()})
    </div>
}
